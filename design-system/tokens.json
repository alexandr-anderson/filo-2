{
  "$schema": "https://design-tokens.org/schema.json",
  "primitive": {
    "color": {
      "plum": {
        "950": { "$value": "#1C1118", "$type": "color" },
        "900": { "$value": "#2A1A23", "$type": "color" },
        "800": { "$value": "#3B2431", "$type": "color" },
        "700": { "$value": "#56364A", "$type": "color" },
        "500": { "$value": "#726168", "$type": "color" },
        "300": { "$value": "#BFAEB6", "$type": "color" },
        "100": { "$value": "#E4D8D9", "$type": "color" },
        "50": { "$value": "#F7F1EF", "$type": "color" }
      },
      "peach": {
        "400": { "$value": "#E8B9A0", "$type": "color" },
        "200": { "$value": "#F2D9CB", "$type": "color" },
        "100": { "$value": "#F8EAE2", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "green": { "600": { "$value": "#3E7B5A", "$type": "color" } },
      "red": { "600": { "$value": "#B23A3A", "$type": "color" } }
    },
    "radius": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "14px", "$type": "dimension" },
      "lg": { "$value": "24px", "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" }
    },
    "font": {
      "display": { "$value": "'Prata', Georgia, serif", "$type": "fontFamily" },
      "body": { "$value": "'Manrope', system-ui, sans-serif", "$type": "fontFamily" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.plum.50}", "$type": "color" },
      "surface": { "$value": "{primitive.color.white}", "$type": "color" },
      "surface-warm": { "$value": "{primitive.color.peach.100}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.plum.900}", "$type": "color" },
      "muted": { "$value": "{primitive.color.plum.500}", "$type": "color" },
      "border": { "$value": "{primitive.color.plum.100}", "$type": "color" },
      "primary": { "$value": "{primitive.color.plum.800}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.plum.700}", "$type": "color" },
      "on-primary": { "$value": "{primitive.color.white}", "$type": "color" },
      "accent": { "$value": "{primitive.color.peach.400}", "$type": "color" },
      "success": { "$value": "{primitive.color.green.600}", "$type": "color" },
      "error": { "$value": "{primitive.color.red.600}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "bg-hover": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "fg": { "$value": "{semantic.color.on-primary}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    },
    "price": {
      "retail": { "$value": "{semantic.color.foreground}", "$type": "color" },
      "wholesale": { "$value": "{semantic.color.primary}", "$type": "color" },
      "wholesale-bg": { "$value": "{semantic.color.surface-warm}", "$type": "color" }
    }
  }
}
